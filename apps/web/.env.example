# Mode démonstration.
#
# Laissé à `true` (ou non défini) tant que le service back-end n'existe pas :
# l'application affiche alors un bandeau permanent indiquant que les
# signalements ne sont transmis à personne, et demande aux moteurs de
# recherche de ne pas l'indexer.
#
# À passer à `false` uniquement lorsque le service est en place et que les
# signalements sont réellement reçus et traités.
VITE_DEMO_MODE=true

# Fond cartographique. Sans valeur, un fond raster OpenStreetMap est utilisé.
# En production, renseigner l'URL d'un style vectoriel hébergé par le client.
# VITE_MAP_STYLE_URL=
